{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookqubit-import-cron",
  "main": "src/index.js",
  "compatibility_date": "2025-05-01",
  // The catalog database (same one the main BookQubit app's CATALOG_DB
  // binding points at) — this worker reads unconsumed rows from
  // `import_chunks` (staged there by prepare_import.py, no R2 or any other
  // external storage needed) and expands them into real `books` rows,
  // updating `import_progress` as it goes. Kept in the catalog DB (not the
  // main "database") since import_chunks/import_progress are purely about
  // growing the book catalog, not user/social data.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog",
      "database_id": "a1795b64-95f5-49c3-9700-3a2c4401a5ba"
    },
    // Lightweight identity-only mirror (book title+author, author names,
    // publisher names — no descriptions/cover/etc.) used purely for the
    // dedup "have we already got this?" check before enriching a candidate.
    // Every continuous-chain hop was running that check straight against
    // the live catalog DB — the same DB the website reads from on every
    // page view — so import traffic and site traffic were contending for
    // the same D1 quota/locks. Dedup reads now go here instead; a
    // confirmed-new book/author/publisher still gets written to BOTH this
    // DB and catalog, so catalog stays the single source of truth for the
    // actual site, untouched by the constant background lookup traffic.
    {
      "binding": "TITLES_DB",
      "database_name": "titles",
      "database_id": "4111fbd4-0bae-4a09-b50c-09684a7848dc"
    }
  ],
  // Workers AI — generates key_points (3 short takeaways) once per book at
  // insert time, from the real fetched synopsis. Free tier: 10,000 neurons/
  // day; this uses roughly 2 neurons/book, nowhere close to that budget.
  "ai": {
    "binding": "AI"
  },
  // Self-referencing service binding — lets a "burst" /run call chain into
  // its own next chunk via env.SELF.fetch() inside ctx.waitUntil(), so a
  // multi-chunk burst keeps running in Cloudflare's infrastructure even
  // after the admin's browser tab that started it closes. Each hop is a
  // fresh invocation with its own subrequest budget, unlike looping inside
  // a single invocation.
  "services": [
    { "binding": "SELF", "service": "bookqubit-import-cron" }
  ],
  // Single cron, every minute — a cheap watchdog, NOT a pacing mechanism.
  // It only does real work (one cheap DB read) when a continuous chain
  // isn't already running; the actual importing happens through the
  // self-chaining /run?continuous=1 loop (see scheduled()/fetch() in
  // src/index.js), which hops from one invocation straight to the next
  // with no delay — real continuous throughput, not "N books per minute".
  // PER_RUN_CHUNKS/D1_BATCH_SIZE govern the optional pre-staged queue (only
  // relevant if you've loaded one via prepare_import.py); OL_* govern the
  // live Open Library fetch, the primary path, no queue needed.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "PER_RUN_CHUNKS": "13",
    "D1_BATCH_SIZE": "100",
    "OL_PAGES_PER_RUN": "3",
    "OL_PAGE_SIZE": "100",
    "OL_MIN_RATING": "4",
    // readinglog_count floor — how many readers have this book on any shelf
    // (want-to-read/reading/already-read combined). Was 200; verified live
    // via wrangler tail that the continuous chain's empty-hop streak climbs
    // steadily toward its 300-hop cutoff without landing a single new book —
    // at 2,033 books already imported, the current subject-rotation offsets
    // are running dry of titles clearing a 200-reader bar. 50 still means
    // "genuinely read by real people," just not exclusively bestseller-tier,
    // and unblocks actual continuous growth instead of empty-cycling forever.
    "OL_MIN_READERS": "50",
    // Default cap for a plain (non burst/target/continuous) manual /run
    // call. Continuous mode always overrides this to 1 book/hop regardless
    // of this value — see the fetch() handler's `continuous` branch.
    "OL_MAX_ENRICH_PER_RUN": "10",
    // How many of each run's book slots go to CURATED_TITLES (Atomic Habits,
    // The Psychology of Money, Sapiens, etc. — real bestsellers OL's own
    // reader-log data underrepresents) before falling back to subject rotation.
    // Continuous mode overrides this to 1/hop, same as OL_MAX_ENRICH_PER_RUN.
    "OL_CURATED_PER_RUN": "2"
  }
}
