{
  "name": "bookqubit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "node scripts/backup-d1.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "seed:local": "node scripts/seed-local-from-prod.mjs",
    "deploy:dev": "node scripts/deploy-dev.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "vitest": "^3.2.7",
    "wrangler": "^4.20.0"
  }
}
