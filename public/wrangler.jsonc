{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookqubitdev",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker-entry.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database",
      "database_id": "b7a72589-843b-4c9a-b793-27e3a1ae2b80"
    },
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog",
      "database_id": "a1795b64-95f5-49c3-9700-3a2c4401a5ba"
    },
    // New, optional databases (ids omitted: created on first deploy, or `wrangler d1 create`).
    // Split by workload so write bursts never contend with accounts or the catalog.
    { "binding": "ENGAGEMENT_DB", "database_name": "engagement", "migrations_dir": "migrations/engagement" },
    { "binding": "MINDSPACE_DB", "database_name": "mindspace", "migrations_dir": "migrations/mindspace" }
  ],
  // Counting plays/clicks/zero-result searches here costs no D1 writes.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "bookqubit_events" }],
  // Bounded semantic-index backfill (see src/lib/cf/backfill.js).
  "triggers": { "crons": ["*/30 * * * *"] },
  "services": [
    {
      "binding": "IMPORT_CRON",
      "service": "bookqubit-import-cron"
    }
  ],
  // ── Added for the BookQubit overhaul (see ../ARCHITECTURE_PLAN.md). Every one of
  // these is OPTIONAL at runtime — src/lib/cf/* degrades gracefully if absent.
  // Before deploying: run the commands in ../DEPLOYMENT_CHECKLIST.md
  // (Queue + Vectorize index must exist; KV/R2 auto-provision on deploy).
  "kv_namespaces": [{ "binding": "CACHE_KV" }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "bookqubit-media" }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "BOOK_VECTORS", "index_name": "bookqubit-vectors" }],
  "queues": {
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "bookqubit-jobs" }],
    "consumers": [{ "queue": "bookqubit-jobs", "max_batch_size": 10, "max_batch_timeout": 5 }]
  },
  "durable_objects": {
    "bindings": [{ "name": "READING_ROOM_DO", "class_name": "ReadingRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReadingRoom"] }],
  // Structured JSON logs from src/lib/cf/logger.js land in Workers Logs; traces need their own flag.
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    // "1" re-applies SCHEMA/CATALOG_SCHEMA + migrations on database access.
    // Keep at "0" in normal operation: applying them on every isolate cold
    // start cost hundreds of pointless query executions per idle half-hour,
    // re-creating tables and re-adding columns that already exist. After
    // editing a schema in db.js: set to "1", deploy, load one page, set back
    // to "0", deploy again. See shouldBootstrap() in src/lib/db.js.
    "RUN_SCHEMA": "0",
    // Books embedded per 30-minute run (one batched AI call + one Vectorize upsert).
    "EMBED_BATCH": "40",
    "EMBED_BACKFILL": "1"
  }
}
