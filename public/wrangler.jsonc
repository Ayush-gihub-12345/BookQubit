{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookqubitdev",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database",
      "database_id": "b7a72589-843b-4c9a-b793-27e3a1ae2b80"
    },
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog",
      "database_id": "a1795b64-95f5-49c3-9700-3a2c4401a5ba"
    },
    { "binding": "ENGAGEMENT_DB", "database_name": "engagement" },
    { "binding": "MINDSPACE_DB", "database_name": "mindspace" }
  ],
  "services": [
    {
      "binding": "IMPORT_CRON",
      "service": "bookqubit-import-cron"
    }
  ],

  // ---------------------------------------------------------------------------
  // PRODUCTION data and edge services (the architecture in ARCHITECTURE_PLAN.md). Each line below is optional at
  // runtime: if a binding is missing or errors, that feature reports "unavailable" or skips the layer, so the site
  // keeps serving. Resources WITHOUT an id are created by wrangler on the first deploy (wrangler >= 4.45).
  //
  //   CACHE_KV        shared cache tier: hot lists, search, feed, cache-group versions (lib/db.js, cache-versions.js)
  //   ENGAGEMENT_DB   write-heavy reader data: shelves, reading log, streaks, audio checkpoints (lib/library-server.js)
  //   MINDSPACE_DB    users' own notes, quotes and idea graphs (lib/mindspace-*.js)
  //   MEDIA_BUCKET    generated audio and covers served by key (lib/cf/consumer.js)
  //   AI              Workers AI: summaries, embeddings, import enrichment (lib/summary.js, lib/cf/ai.js)
  //
  // After the first deploy apply the SQL once (all of it is idempotent), see DEPLOYMENT_CHECKLIST.md:
  //   wrangler d1 execute engagement --remote --file=migrations/engagement/0001_engagement.sql
  //   wrangler d1 execute mindspace  --remote --file=migrations/mindspace/0001_mindspace.sql
  //   wrangler d1 execute catalog    --remote --file=migrations/catalog/0001_fts_summaries.sql
  //   wrangler d1 execute catalog    --remote --command="INSERT INTO books_fts(books_fts) VALUES('rebuild'); INSERT INTO authors_fts(authors_fts) VALUES('rebuild');"
  //
  // PHASE 2 (needs resources created by hand first, so it is NOT enabled here; see DEPLOYMENT_CHECKLIST.md):
  //   "queues": { "producers": [{ "binding": "JOBS", "queue": "bookqubit-jobs" }], "consumers": [{ "queue": "bookqubit-jobs" }] }
  //   "vectorize": [{ "binding": "BOOK_VECTORS", "index_name": "bookqubit-vectors" }]
  //   "durable_objects": { "bindings": [{ "name": "READING_ROOM_DO", "class_name": "ReadingRoom" }] },
  //     "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReadingRoom"] }]
  //   "triggers": { "crons": ["*/30 * * * *"] }   and   "main": "worker-entry.js"   (adds queue, cron and Durable Object handlers)
  // ---------------------------------------------------------------------------
  "kv_namespaces": [{ "binding": "CACHE_KV" }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET" }],
  "ai": { "binding": "AI" },

  // Workers Logs. It was OFF in production (confirmed from the account's
  // Worker settings: no `observability` block), so failures were invisible:
  // between 1% and 9% of requests end in `exceededResources` every day and
  // there was no record of which route did it. 100% sampling is fine at the
  // current volume (~35k requests/day, about 1M events/month, against 20M
  // included); lower head_sampling_rate if traffic grows tenfold. Log OBJECTS,
  // not strings, so the fields are searchable.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // "1" re-applies SCHEMA/CATALOG_SCHEMA + migrations on database access.
    // Keep at "0" in normal operation: applying them on every isolate cold
    // start cost hundreds of pointless query executions per idle half-hour,
    // re-creating tables and re-adding columns that already exist. After
    // editing a schema in db.js: set to "1", deploy, load one page, set back
    // to "0", deploy again. See shouldBootstrap() in src/lib/db.js.
    "RUN_SCHEMA": "0"
  },

  // ---------------------------------------------------------------------------
  // DEV environment: Worker "bookqubit-dev-site", deployed from the `dev` branch.
  // Deploy with `npm run deploy:dev` (Workers Builds runs it on pushes to `dev`).
  //
  // Bindings are NOT inherited from the production config above, so everything
  // dev may touch is listed here, and it is deliberately limited:
  //  - its own two D1 databases (never the production ids; tests/dev-environment
  //    .test.js fails if these ever match),
  //  - no IMPORT_CRON service binding (the importer writes to the production
  //    catalog), so admin import routes report "not configured" in dev,
  //  - no secrets: ADMIN_*, RESEND_*, IMPORT_* are unset, so admin login fails
  //    closed and email sending degrades instead of sending real mail.
  // Set a dev-only admin login with `wrangler secret put ADMIN_USERNAME --env dev`.
  // ---------------------------------------------------------------------------
  "env": {
    "dev": {
      "name": "bookqubit-dev-site",
      "main": ".open-next/worker.js",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "compatibility_date": "2025-05-01",
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "d1_databases": [
        { "binding": "DB", "database_name": "bookqubit-dev-database", "database_id": "48a757c3-22d8-4f03-9180-7075f04f2825" },
        { "binding": "CATALOG_DB", "database_name": "bookqubit-dev-catalog", "database_id": "a95e1940-7268-4f0d-bf47-a3b86f27f9de" },
        // Created by wrangler on the first dev deploy (no id) and filled by scripts/deploy-dev.mjs, which applies the
        // idempotent SQL in migrations/ after each deploy. Never the production databases.
        { "binding": "ENGAGEMENT_DB", "database_name": "bookqubit-dev-engagement" },
        { "binding": "MINDSPACE_DB", "database_name": "bookqubit-dev-mindspace" }
      ],
      "r2_buckets": [{ "binding": "MEDIA_BUCKET" }],
      "ai": { "binding": "AI" },
      "services": [],
      // Workers KV for the shared cache tier (see src/lib/db.js). No id on purpose: wrangler creates a namespace
      // for THIS Worker on deploy, so dev never shares a namespace with production. If KV is missing or errors,
      // the cache simply skips that layer (memory, edge and database still serve).
      "kv_namespaces": [{ "binding": "CACHE_KV" }],
      "vars": { "RUN_SCHEMA": "0" }
    }
  }
}
