{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookqubitdev",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database",
      "database_id": "b7a72589-843b-4c9a-b793-27e3a1ae2b80"
    },
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog",
      "database_id": "a1795b64-95f5-49c3-9700-3a2c4401a5ba"
    }
  ],
  "services": [
    {
      "binding": "IMPORT_CRON",
      "service": "bookqubit-import-cron"
    }
  ],
  "vars": {
    // "1" re-applies SCHEMA/CATALOG_SCHEMA + migrations on database access.
    // Keep at "0" in normal operation: applying them on every isolate cold
    // start cost hundreds of pointless query executions per idle half-hour,
    // re-creating tables and re-adding columns that already exist. After
    // editing a schema in db.js: set to "1", deploy, load one page, set back
    // to "0", deploy again. See shouldBootstrap() in src/lib/db.js.
    "RUN_SCHEMA": "0"
  }
}
