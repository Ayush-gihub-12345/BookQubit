{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bookqubit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "public"
      ],
      "port": 3000
    },
    {
      "name": "bookqubit-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "public"
      ],
      "port": 8787
    },
    {
      "name": "bookqubit-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local",
        "--prefix",
        "public"
      ],
      "port": 3000
    }
  ]
}
